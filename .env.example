# Copier dans data/.env (jamais dans le dépôt) et remplir.
# Le .env complet généré par `hermes setup` contient aussi des réglages
# non secrets (timeouts, debug) qui ont tous une valeur par défaut.

# Bot Discord — Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=
# IDs Discord autorisés à parler à Robert, séparés par des virgules
DISCORD_ALLOWED_USERS=

# MCP Brevo — token fourni par Brevo (Settings > SMTP & API > MCP).
# L'IP du serveur doit être autorisée sur https://app.brevo.com/security/authorised_ips
BREVO_MCP_TOKEN=

# CLI Scaleway (scw) — clé API d'une application IAM dédiée à Robert
# (console Scaleway > IAM > Applications), avec les seules permissions utiles à la démo.
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=
SCW_DEFAULT_REGION=fr-par
SCW_DEFAULT_ZONE=fr-par-1

# MCP GitHub — fine-grained personal access token dédié à Robert
# (github.com/settings/personal-access-tokens), limité aux dépôts de la démo.
GITHUB_MCP_TOKEN=
