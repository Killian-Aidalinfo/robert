# Copier dans hindsight/.env (jamais dans le dépôt). Générer chaque valeur avec :
#   openssl rand -hex 32

# Clé exigée par l'API Hindsight. La même valeur va dans data/hindsight/config.json (api_key).
HINDSIGHT_API_TENANT_API_KEY=
# L'interface web lit l'API avec cette clé : même valeur que ci-dessus.
HINDSIGHT_CP_DATAPLANE_API_KEY=
# Mot de passe demandé à l'ouverture de l'interface web.
HINDSIGHT_CP_ACCESS_KEY=
